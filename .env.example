APP_ENV=development
DATABASE_PATH=data/parkingpot.sqlite3
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Use the same value across restarts/workers.
AUTH_SECRET=
SESSION_TTL_SECONDS=604800
CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=60
CODE_MAX_ATTEMPTS=5
# Comma-separated frontend origins, without a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# file: development-only .eml messages; smtp: actual email delivery.
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=data/outbox
MAIL_FROM=ParkingPot <noreply@parkingpot.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465), or none (local test server only).
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
