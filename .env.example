APP_ENV=development
DATABASE_PATH=data/parkingpot.sqlite3
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Use the same value across restarts/workers.
AUTH_SECRET=
SESSION_TTL_SECONDS=604800
CODE_TTL_SECONDS=600
CODE_RESEND_SECONDS=60
CODE_MAX_ATTEMPTS=5
# Comma-separated frontend origins, without a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# file: development-only .eml messages; smtp: actual email delivery.
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=data/outbox
MAIL_FROM=ParkingPot <noreply@parkingpot.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465), or none (local test server only).
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# Use each API's decoded service key. Keep actual keys in .env only.
PARKING_CATALOG_SERVICE_KEY=
PARKING_STATUS_SERVICE_KEY=
PARKING_DB_PATH=parking.db
PARKING_REALTIME_REFRESH_SECONDS=120
# Optional regional filter for realtime availability.
PARKING_REALTIME_SIDO_CODE=
PARKING_REALTIME_SIGUNGU_CODE=
